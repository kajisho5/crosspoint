# SW CROSSPOINT — TestFlight 配布（Mac 不要。GitHub Actions の macOS ランナーで実行）
# 必要な環境変数（GitHub Secrets）：docs/TESTFLIGHT.md
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8（.p8 の中身そのまま）
#   APPLE_TEAM_ID
#   MATCH_GIT_URL（https://<user>:<token>@github.com/<user>/crosspoint-certs.git）/ MATCH_PASSWORD
default_platform(:ios)

BUNDLE_ID = ENV["APP_BUNDLE_ID"] || "com.seventhwell.crosspoint"
WORKSPACE = "SWCROSSPOINT.xcworkspace"
XCODEPROJ = "ios/SWCROSSPOINT.xcodeproj"
SCHEME = "SWCROSSPOINT"

platform :ios do
  desc "署名（match）→ ビルド番号採番 → アーカイブ → TestFlight（内部テスト）へアップロード"
  lane :testflight do
    setup_ci # 一時キーチェーン（CI 用）

    key_path = File.expand_path("../build/AuthKey.p8", __dir__)
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # 配布証明書＋App Store プロファイル。初回はランナー上で生成して MATCH_GIT_URL のリポへ暗号化保存、以後は再利用
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "main",
      readonly: false,
      api_key: api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      platform: "ios"
    )
    profile_name = ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name")

    # ビルド番号：TestFlight の最新 + 1（初回は 1）
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      initial_build_number: 0
    ) + 1
    UI.message("build number = #{build_number}")

    update_code_signing_settings(
      path: XCODEPROJ,
      targets: [SCHEME],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: profile_name
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "SWCROSSPOINT.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name },
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"]
    )
    UI.success("TestFlight にアップロードしました（build #{build_number}）")
  end
end
